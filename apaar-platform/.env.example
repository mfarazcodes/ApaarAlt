# ── Required in production (the app refuses to start without them; development has safe fallbacks) ──

# Keys the HMAC that turns government IDs into vault tokens. Use a long random value:  openssl rand -hex 32
VAULT_PEPPER=

# Signs the session cookie. Use a long random value:  openssl rand -hex 32
SESSION_SECRET=

# The Ed25519 private key that signs Smart QR credentials and the audit-chain head.
# PEM on one line, with a literal backslash-n between lines.  Generate:  openssl genpkey -algorithm ed25519
ISSUER_PRIVATE_KEY_PEM=

# ── Recommended ──

# Postgres connection string. Without it, state lives in memory and is lost on restart.
DATABASE_URL=

# ── Optional ──

# On by default. Set to false for a real deployment: it removes the one-click demo personas,
# the phone simulator and the demo reset.
DEMO_MODE=true

# One salt per institution for vault tokens. Defaults to a demo value.
TOKEN_SALT=

# A stable id for the signing key. Defaults to a hash of the public key.
ISSUER_KID=

# Public keys that stopped signing but whose QRs should still verify, after a rotation.
# JSON: [{"kid":"abc123","pem":"-----BEGIN PUBLIC KEY-----
...
-----END PUBLIC KEY-----"}]
ISSUER_RETIRED_PUBLIC_KEYS=
