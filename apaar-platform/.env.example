# Secret used to key the HMAC that turns government IDs into vault tokens.
# Required in production. Use a long random value, e.g. `openssl rand -hex 32`.
VAULT_PEPPER=

# Optional Ed25519 private key (PEM, with literal backslash-n for newlines) used to sign Smart QR credentials.
# Without it an ephemeral key is generated on each start. Required in production.
# Generate one with: openssl genpkey -algorithm ed25519
ISSUER_PRIVATE_KEY_PEM=
